# StudySpace — Prisma Schema
# Sprint 1-4 + Sprint 5
# DB: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum NoteStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportTarget {
  NOTE
  USER
  COMMUNITY
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  CHAT_MESSAGE
  VIDEO_ROOM_STARTED
  NOTE_APPROVED
  NOTE_REJECTED
  NEW_FOLLOWER
  REPORT_ACTIONED
}

enum SearchType {
  NOTES
  USER
  COMMUNITY
  ALL
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  avatarUrl     String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  communities       CommunityMember[]
  notes             Note[]
  reports           Report[]
  messages          Message[]
  videoRooms        VideoRoom[]
  notifications     Notification[]
  followers         Follow[] @relation("following")
  following         Follow[] @relation("follower")
  searchLogs        SearchLog[]
  noteViews         NoteView[]
  aiSessions        AISession[]
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User @relation("follower",  fields: [followerId],  references: [id])
  following   User @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Community {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  coverUrl    String?
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime  @updatedAt

  members    CommunityMember[]
  notes      Note[]
  reports    Report[]
  messages   Message[]
  videoRooms VideoRoom[]
}

model CommunityMember {
  id          String      @id @default(cuid())
  userId      String
  communityId String
  role        MemberRole  @default(MEMBER)
  joinedAt    DateTime    @default(now())

  user        User      @relation(fields: [userId],      references: [id])
  community   Community @relation(fields: [communityId], references: [id])

  @@unique([userId, communityId])
  @@index([communityId])
}

model Note {
  id          String     @id @default(cuid())
  title       String
  content     String
  fileUrl     String?
  status      NoteStatus @default(PENDING)
  authorId    String
  communityId String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author      User      @relation(fields: [authorId],    references: [id])
  community   Community @relation(fields: [communityId], references: [id])
  reports     Report[]
  noteViews   NoteView[]
  aiSessions  AISession[]

  @@index([communityId, status])
  @@index([authorId])
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  target      ReportTarget
  status      ReportStatus @default(OPEN)
  reason      String
  noteId      String?
  communityId String?
  reportedId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reporter    User       @relation(fields: [reporterId],  references: [id])
  note        Note?      @relation(fields: [noteId],      references: [id])
  community   Community? @relation(fields: [communityId], references: [id])

  @@index([status])
  @@index([reporterId])
}

model Message {
  id          String    @id @default(cuid())
  content     String
  senderId    String
  communityId String
  createdAt   DateTime  @default(now())

  sender      User      @relation(fields: [senderId],    references: [id])
  community   Community @relation(fields: [communityId], references: [id])

  @@index([communityId, createdAt])
}

model VideoRoom {
  id          String     @id @default(cuid())
  hmsRoomId   String     @unique
  communityId String?
  createdById String
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  community   Community? @relation(fields: [communityId], references: [id])
  createdBy   User       @relation(fields: [createdById], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model SearchLog {
  id        String     @id @default(cupid())
  userId    String
  query     String
  type      SearchType
  results   Int
  createdAt DateTime   @default(now())

  user      User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([query])
}

model NoteView {
  id        String   @id @default(cuid())
  noteId    String
  userId    String
  createdAt DateTime @default(now())

  note      Note @relation(fields: [noteId], references: [id])
  user      User @relation(fields: [userId], references: [id])

  @@unique([noteId, userId])
  @@index([noteId])
}

model AISession {
  id        String   @id @default(cuid())
  userId    String
  noteId    String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id])
  note      Note @relation(fields: [noteId], references: [id])

  @@index([userId])
  @@index([noteId])
}

// Study Room Models
enum StudyRoomType {
  OPEN
  SUBJECT
  PRIVATE
  BATCH
  FOCUS
}

enum StudyRoomStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model StudyRoom {
  id            String   @id @default(cuid())
  name          String
  description   String?
  type          StudyRoomType
  status        StudyRoomStatus @default(ACTIVE)
  password      String?       // For private rooms
  maxCapacity   Int           @default(50)
  currentUsers  Int           @default(0)
  isPermanent   Boolean       @default(false) // For batch/rooms that persist
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  expiresAt     DateTime?     // For temporary rooms

  // Relations
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  communityId   String?       // Optional: link to community for subject/batch rooms
  community     Community?    @relation(fields: [communityId], references: [id])

  sessions      StudyRoomSession[]
  messages      StudyRoomMessage[]
  settings      StudyRoomSettings?
  accessList    StudyRoomAccess[]

  @@index([type, status])
  @@index([communityId])
  @@index([createdById])
}

model StudyRoomSession {
  id          String   @id @default(cuid())
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  duration    Int?     // In seconds, calculated when left
  goal        String?  // User's goal for this session
  goalMet     Boolean? // Whether user achieved their goal
  isFocusMode Boolean  // Whether focus mode was enabled during session

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  studyRoomId String
  studyRoom   StudyRoom @relation(fields: [studyRoomId], references: [id])

  @@unique([userId, studyRoomId, joinedAt])
  @@index([studyRoomId, joinedAt])
  @@index([userId])
}

model StudyRoomMessage {
  id         String   @id @default(cuid())
  content    String
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relations
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  studyRoomId String
  studyRoom  StudyRoom @relation(fields: [studyRoomId], references: [id])

  @@index([studyRoomId, createdAt])
}

model StudyRoomSettings {
  id               String   @id @default(cuid())
  pomodoroWorkInt  Int      @default(25)    // minutes
  pomodoroBreakInt Int      @default(5)     // minutes
  ambientSound     String?  // lo-fi, rain, white-noise, none
  isChatEnabled    Boolean  @default(true)
  isAudioEnabled   Boolean  @default(true)
  isVideoEnabled   Boolean  @default(true)
  maxVideoUsers    Int      @default(10)

  // Relations
  studyRoomId      String   @unique
  studyRoom        StudyRoom @relation(fields: [studyRoomId], references: [id])
}

model StudyRoomAccess {
  id         String   @id @default(cuid())
  grantedAt  DateTime @default(now())
  grantedById String

  // Relations
  studyRoomId String
  studyRoom   StudyRoom @relation(fields: [studyRoomId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  @@unique([studyRoomId, userId])
  @@index([userId])
}